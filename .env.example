# Copy to .env.local and fill in. Everything is optional for `npm run dev` (offline fallback data is used).

# --- Public site config (inlined into the static bundle) ---
NEXT_PUBLIC_SITE_URL=https://th-master.web.app
NEXT_PUBLIC_CONTACT_EMAIL=contacto@example.com

# Google AdSense (ads + ads.txt are only generated when set)
NEXT_PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=      # display ad unit slot id
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Google Analytics 4 (optional, loaded only after human interaction)
NEXT_PUBLIC_GA_MEASUREMENT_ID=         # G-XXXXXXXXXX

# Firebase Web SDK + App Check (optional client-side reads / reCAPTCHA v3 bot signal)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# --- Build-time data source ---
# Set to "firestore" to read words from Cloud Firestore during `next build` (needs admin credentials below).
WORDS_SOURCE=fallback

# --- Server-only credentials (build machine / seeder; NEVER prefix with NEXT_PUBLIC_) ---
FIREBASE_PROJECT_ID=
# Either a path to a service-account JSON file (ADC)...
GOOGLE_APPLICATION_CREDENTIALS=
# ...or the JSON itself on one line (useful in CI).
FIREBASE_SERVICE_ACCOUNT_JSON=
GCS_BUCKET_NAME=                       # e.g. your-project.appspot.com

# --- Seeder (npm run seed) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TTS_VOICE=en-US-Neural2-J
